{
  "name": "worms-online",
  "productName": "Worms Online",
  "version": "0.1.1",
  "description": "Worms Online (wormsonline.net) as a desktop app: the game page in its own Chromium, with no browser throttling",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.ropersheaven.wormsonline",
    "productName": "Worms Online",
    "artifactName": "WormsOnline-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "update.js",
      "offline.html",
      "package.json"
    ],
    "afterPack": "build/afterpack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "afterSign": "build/afterpack.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://wormsonline.net/app/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
